# AI Orchestrator — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# ── Required ──────────────────────────────────────────────────────────────────
# Path to your Obsidian vault (or any directory containing your queue file)
ORCH_VAULT_PATH=C:\Users\you\obsidian_vault

# ── Queue (optional) ──────────────────────────────────────────────────────────
# Direct path to queue file. Defaults to <ORCH_VAULT_PATH>/99_System/AI/agent-queue.md
# ORCH_QUEUE_FILE=

# ── Security: Allowed Working Directories ─────────────────────────────────────
# Semicolon-separated list of root paths that cwd: tags are validated against.
# Leave unset (or empty) to allow all paths — set it to restrict task execution
# to specific directories only.
# ALLOWED_CWD_ROOTS=C:\projects;D:\work

# ── Telegram (optional) ───────────────────────────────────────────────────────
# Required for Telegram notifications, bot commands, and approval flows.
# Create a bot via @BotFather, then get your chat ID via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Provider Capacity Thresholds ──────────────────────────────────────────────
# Minimum remaining capacity (%) before a provider is considered exhausted.
# MIN_CAPACITY_PERCENT=10

# Per-window thresholds (override MIN_CAPACITY_PERCENT for specific windows):
# CLAUDE_FIVE_HOUR_MIN_CAPACITY_PCT=10
# CLAUDE_SEVEN_DAY_MIN_CAPACITY_PCT=3
# CODEX_PRIMARY_MIN_CAPACITY_PCT=10
# CODEX_SECONDARY_MIN_CAPACITY_PCT=3

# ── Claude HTTP 429 Local Fallback ────────────────────────────────────────────
# Enables reading token usage from local JSONL files instead of the monitoring API
# when cclimits returns HTTP 429. Requires: pip install claude-monitor
# Values: pro | max5 | max20 | custom
# CLAUDE_PLAN=pro

# ── Gemini HTTP API (optional) ────────────────────────────────────────────────
# The consumer Gemini CLI was shut down 2026-06-18. Set a Google AI Studio key
# (https://aistudio.google.com/apikey) to use the Gemini provider via the HTTP
# REST API instead of the CLI. Free tier needs no billing — don't enable billing
# unless you want pay-per-token. Without a key the provider falls back to the
# legacy `gemini` CLI (Standard/Enterprise subscriptions only).
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_DEFAULT_MODEL=gemini-3.5-flash
# GEMINI_MAX_OUTPUT_TOKENS=16384

# ── OpenRouter (optional, pay-per-token) ──────────────────────────────────────
# Setting a key registers OpenRouter as an opt-in provider for non-agentic
# single calls (heartbeat checks, summaries, second opinions). It NEVER enters
# the fallback chain — activate per task via #openrouter or an #or_* alias.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_DEFAULT_MODEL=minimax/minimax-m2.5:free

# ── Mistral Vibe (optional second non-Claude voice) ───────────────────────────
# Enabled purely by having the `vibe` CLI on PATH (`uv tool install mistral-vibe`);
# no key goes here — vibe keeps its own auth in ~/.vibe. It never enters the
# fallback chain: tag a task #vibe or use #second_opinion:vibe. Pay-per-token via
# Mistral's API, so every run carries a hard cost ceiling.
# VIBE_MAX_PRICE_USD=0.50
# VIBE_MAX_TURNS=12
# VIBE_READONLY_MAX_TURNS=1

# ── opencode CLI (optional, Stufe 2: tag-activated third external voice) ──────
# No key goes here either — opencode keeps its own auth (~/.config/opencode/
# auth.json) and its own agent/model config (~/.config/opencode/opencode.json,
# read-only from this repo — see `--doctor`'s opencode check). It never enters
# the fallback chain: tag a task #opencode or a handpicked alias
# (#opencode_deepseek / #opencode_deepseek_long / #opencode_glm).
# Vorbedingung: the OPENROUTER_API_KEY above (opencode routes through it) MUST
# carry a spending cap (`limit` set at https://openrouter.ai/settings/keys) —
# without one, AllLimits.opencode stays permanently available=False and
# opencode never routes (fail-closed by design, see limits.py).
# ACHTUNG, geteilter Deckel: OPENROUTER_API_KEY speist BEIDE Wege — den
# HTTP-Provider (#openrouter / #or_*) und opencode. Beide zehren also am
# selben Tagesbudget, und ein #or_*-Lauf kann opencode sperren, ohne dass
# opencode gelaufen ist. Wer die zwei trennen will, legt zwei gedeckelte
# Keys an und zeigt opencodes auth.json auf den anderen.
# OPENCODE_IDLE_TIMEOUT_SEC=300
# OPENCODE_MAX_PROMPT_BYTES=50000
# OPENCODE_MIN_REMAINING_USD=0.25
# OPENCODE_PICKER_PROFILE=zdr
# OPENCODE_MODEL_PICKER=
# OPENCODE_DEFAULT_MODEL=openrouter/zdr-review
# OPENCODE_CONFIG_PATH=

# ── Claude CLI sessions (optional, default off) ───────────────────────────────
# Share a Claude --session-id/--resume across the phases of a tool run for
# cross-call prompt-cache hits (~30-50 % token savings). Off = stateless calls.
# CLAUDE_SESSION_ENABLED=false
# Retention for orchestrator-created session JSONL files in ~/.claude/projects/
# ORCH_SESSION_RETENTION_DAYS=14

# ── Quota estimation (optional, default off) ──────────────────────────────────
# Phase 2: decrement the cached cclimits snapshot by a live per-task estimate
# between polls, and optionally re-derive the calibration factors daily from
# logs/quota-calibration.csv. Off keeps cclimits the per-poll source of truth.
# ORCH_QUOTA_LIVE_ESTIMATE=false
# ORCH_QUOTA_AUTO_RECALIBRATE=false

# ── PR-Babysitter (optional, requires the `gh` CLI) ───────────────────────────
# Default repo list for #tool:pr-babysitter when the task carries no #repos: tag.
# PR_BABYSITTER_REPOS=owner/repo1;owner/repo2
# PR_BABYSITTER_QUEUE_COOLDOWN_HOURS=1

# ── CI-Failure-Watcher (optional, requires the `gh` CLI) ──────────────────────
# Empty list disables the check-ci-failures heartbeat handler entirely.
# CI_WATCHER_REPOS=owner/repo1;owner/repo2
# Optional repo -> local clone mapping so the queued fix task gets a usable cwd:
# CI_WATCHER_REPO_PATHS=owner/repo1=D:\projects\repo1
# CI_WATCHER_QUEUE_COOLDOWN_HOURS=2

# ── Dashboard ─────────────────────────────────────────────────────────────────
# DASHBOARD_PORT=8211

# ── Telegram Rate Limits ──────────────────────────────────────────────────────
# Max task text length accepted via /task command (characters)
# TELEGRAM_MAX_TASK_LENGTH=500
