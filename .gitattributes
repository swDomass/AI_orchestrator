# Normalize all text files to LF in the repository
* text=auto eol=lf

# Explicitly binary files — no line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary

# Vendorte Dashboard-Bibliotheken: Bytes unveraendert, keine Zeilenenden-Umwandlung
dashboard_ui/vendor/** -text linguist-vendored
